{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-report.schema.json",
  "title": "Parliament Review Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_range", "reviewers", "findings", "validation", "verdict"],
  "properties": {
    "schema_version": { "const": 1 },
    "review_range": {
      "type": "object", "additionalProperties": false,
      "required": ["base", "head", "included_paths"],
      "properties": {
        "base": { "type": "string", "minLength": 1 },
        "head": { "type": "string", "minLength": 1 },
        "included_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "reviewers": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "status", "verdict", "evidence"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "status": { "enum": ["reported", "missing"] },
          "verdict": { "enum": ["APPROVE", "CHANGES REQUESTED", "INCOMPLETE"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "severity", "blocking", "disposition", "evidence", "impact", "recommendation", "resolution"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "blocking": { "type": "boolean" },
          "disposition": { "enum": ["open", "resolved", "accepted-risk", "rejected"] },
          "evidence": { "type": "string", "minLength": 1 },
          "impact": { "type": "string", "minLength": 1 },
          "recommendation": { "type": "string", "minLength": 1 },
          "resolution": { "type": "string" }
        }
      }
    },
    "validation": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["command", "result", "evidence"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail", "not-run"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verdict": { "enum": ["APPROVE", "CHANGES REQUESTED", "INCOMPLETE"] }
  },
  "$defs": {
    "review_range": {
      "type": "object", "additionalProperties": false,
      "required": ["base", "head", "included_paths"],
      "properties": {
        "base": { "type": "string", "minLength": 1 },
        "head": { "type": "string", "minLength": 1 },
        "included_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "allOf": [
  { "properties": { "reviewers": { "contains": { "properties": { "role": { "const": "correctness-reviewer" } }, "required": ["role"] }, "minContains": 1, "maxContains": 1 } } },
  { "properties": { "reviewers": { "contains": { "properties": { "role": { "const": "security-reviewer" } }, "required": ["role"] }, "minContains": 1, "maxContains": 1 } } },
  {
    "if": { "properties": { "verdict": { "const": "APPROVE" } }, "required": ["verdict"] },
    "then": {
      "properties": {
        "reviewers": {
          "contains": { "properties": { "role": { "const": "correctness-reviewer" }, "status": { "const": "reported" }, "verdict": { "const": "APPROVE" } }, "required": ["role", "status", "verdict"] },
          "minContains": 1
        },
        "findings": {
          "not": { "contains": { "properties": { "blocking": { "const": true }, "disposition": { "const": "open" } }, "required": ["blocking", "disposition"] } }
        }
      },
      "allOf": [{ "properties": { "reviewers": { "contains": { "properties": { "role": { "const": "security-reviewer" }, "status": { "const": "reported" }, "verdict": { "const": "APPROVE" } }, "required": ["role", "status", "verdict"] }, "minContains": 1 } } }]
    }
  }]
}
