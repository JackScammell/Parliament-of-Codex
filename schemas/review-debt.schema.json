{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-debt.schema.json",
  "title": "Review Debt",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "change", "skipped_optional_reviews", "owner", "due_at", "status", "follow_up"],
  "properties": {
    "schema_version": { "const": 1 }, "id": { "type": "string", "minLength": 1 }, "change": { "type": "string", "minLength": 1 },
    "skipped_optional_reviews": { "type": "array", "minItems": 1, "items": { "enum": ["accessibility-reviewer", "architecture-reviewer", "cost-reviewer", "documentation-reviewer", "i18n-reviewer", "maintainability-reviewer", "performance-reviewer", "privacy-reviewer", "standards-reviewer", "testing-reviewer"] } }, "owner": { "type": "string", "minLength": 1 },
    "due_at": { "type": "string", "format": "date-time" }, "status": { "enum": ["open", "in-progress", "resolved", "overdue"] },
    "follow_up": { "type": "string", "minLength": 1 }, "resolution": { "type": "string" }
  },
  "allOf": [{
    "if": { "properties": { "status": { "const": "resolved" } }, "required": ["status"] },
    "then": { "required": ["resolution"], "properties": { "resolution": { "type": "string", "minLength": 1 } } }
  }]
}
