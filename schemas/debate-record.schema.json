{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "debate-record.schema.json",
  "title": "Debate Record",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "question", "constraints", "owner", "deadline", "participants", "challenge", "decision", "alternatives", "dissent", "validation", "revisit_trigger", "replay_link"],
  "properties": {
    "schema_version": { "const": 1 }, "question": { "type": "string", "minLength": 1 },
    "constraints": { "type": "array", "items": { "type": "string" } }, "owner": { "type": "string", "minLength": 1 },
    "deadline": { "type": "string", "format": "date-time" },
    "participants": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["role", "position", "evidence"], "properties": { "role": { "type": "string" }, "position": { "type": "string" }, "evidence": { "type": "array", "items": { "type": "string" } } } } },
    "challenge": { "type": "string" }, "decision": { "type": "string", "minLength": 1 },
    "alternatives": { "type": "array", "items": { "type": "string" } }, "dissent": { "type": "array", "items": { "type": "string" } },
    "validation": { "type": "array", "items": { "type": "string" } }, "revisit_trigger": { "type": "string", "minLength": 1 }, "replay_link": { "type": ["string", "null"] }
  }
}
